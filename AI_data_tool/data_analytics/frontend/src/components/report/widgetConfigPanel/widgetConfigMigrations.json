{
  "_comment": "E03: legacy widget-config shapes and what they migrate to. Read by BOTH configShape.test.tsx beside it (migrateWidgetConfig) and backend tests/test_widget_config_shape.py (migrate_widget_config). It lives here because the frontend image type-checks its tests with only the frontend folder in its build context, so the two implementations cannot drift. `out` equal to `in` means: left alone.",
  "cases": [
    {"name": "roles only: flattened (the demo's map widgets)",
     "in":  {"dataset_id": 3, "roles": {"lat": "origin_lat", "lon": "origin_lon", "measure": "shipments"}, "cluster_cell_degrees": 10},
     "out": {"dataset_id": 3, "lat": "origin_lat", "lon": "origin_lon", "measure": "shipments", "cluster_cell_degrees": 10}},
    {"name": "category roles become dimension keys",
     "in":  {"roles": {"category": "from_city", "category2": "to_city", "measure": "shipments"}},
     "out": {"dimension": "from_city", "dimension2": "to_city", "measure": "shipments"}},
    {"name": "a multi-value role stays under its own name",
     "in":  {"measures": ["revenue", "cost"], "roles": {"measures": ["revenue", "cost"]}, "aggregation": "sum"},
     "out": {"measures": ["revenue", "cost"], "aggregation": "sum"}},
    {"name": "empty role values are dropped, not written as empty keys",
     "in":  {"roles": {"measure": "revenue", "category": ""}, "aggregation": "sum"},
     "out": {"measure": "revenue", "aggregation": "sum"}},
    {"name": "flat keys that agree with roles: flattened",
     "in":  {"dimension": "region", "roles": {"category": "region", "measure": "revenue"}},
     "out": {"dimension": "region", "measure": "revenue"}},
    {"name": "flat keys that disagree with roles: left alone (which one renders depends on the chart)",
     "in":  {"dimension": "region", "roles": {"category": "country", "measure": "revenue"}},
     "out": {"dimension": "region", "roles": {"category": "country", "measure": "revenue"}}},
    {"name": "a flat role key roles would hide: left alone",
     "in":  {"dimension": "region", "roles": {"measure": "revenue"}},
     "out": {"dimension": "region", "roles": {"measure": "revenue"}}},
    {"name": "an empty roles dict hides every flat key: left alone",
     "in":  {"dimension": "region", "roles": {}},
     "out": {"dimension": "region", "roles": {}}},
    {"name": "an empty roles dict on its own is dropped",
     "in":  {"aggregation": "sum", "roles": {}},
     "out": {"aggregation": "sum"}},
    {"name": "agg becomes aggregation",
     "in":  {"dimension": "region", "measure": "revenue", "agg": "avg"},
     "out": {"dimension": "region", "measure": "revenue", "aggregation": "avg"}},
    {"name": "agg beside aggregation is dead (aggregation is read first): dropped",
     "in":  {"aggregation": "sum", "agg": "avg"},
     "out": {"aggregation": "sum"}},
    {"name": "a current config is unchanged",
     "in":  {"dimension": "region", "measure": "revenue", "aggregation": "sum", "interaction": {"broadcasts": false}},
     "out": {"dimension": "region", "measure": "revenue", "aggregation": "sum", "interaction": {"broadcasts": false}}},
    {"name": "roles that is not an object: left alone",
     "in":  {"roles": "category"},
     "out": {"roles": "category"}}
  ]
}
