2026-09-26 09:29:44.832 UTC [207977] STATEMENT:  SELECT 
	  s.seller_city AS seller_city,
	  s.seller_state AS seller_state,
	  COUNT(DISTINCT o.order_id) AS total_orders,
	  AVG(oi.price) AS avg_item_price,
	  AVG(oi.freight_value) AS avg_freight,
	  AVG(CASE 
	    WHEN o.order_status = 'delivered' 
	    THEN (julianday(o.order_delivered_customer_date) - julianday(o.order_purchase_timestamp)) 
	    ELSE NULL 
	  END) AS avg_delivery_days,
	  AVG(CASE 
	    WHEN o.order_status = 'delivered' 
	    THEN (julianday(o.order_delivered_customer_date) - julianday(o.order_estimated_delivery_date)) 
	    ELSE NULL 
	  END) AS avg_delay_days,
	  COUNT(DISTINCT CASE WHEN o.order_status = 'canceled' THEN o.order_id END) AS canceled_orders,
	  AVG(r.review_score) AS avg_review_score,
	  COUNT(DISTINCT r.review_id) AS total_reviews
	FROM orders o
	JOIN order_items oi ON o.order_id = oi.order_id
	JOIN sellers s ON oi.seller_id = s.seller_id
	LEFT JOIN order_reviews r ON o.order_id = r.order_id
	WHERE o.order_purchase_timestamp >= '2017-01-01'
	GROUP BY s.seller_city, s.seller_state
	ORDER BY avg_delay_days DESC NULLS LAST;
