  {
   "id": "total-revenue.en",
   "lang": "en",
   "question": "What is the total revenue?",
   "expect": {
    "kind": "number",
    "from": {
     "widget_type": "kpi",
     "config": {
      "measure": "revenue",
      "aggregation": "sum",
      "filters": []
     }
    }
   }
