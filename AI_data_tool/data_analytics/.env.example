POSTGRES_DB=datalytics
POSTGRES_USER=datalytics
POSTGRES_PASSWORD=datalytics_secret
SECRET_KEY=change_me_in_production
ALLOWED_ORIGINS=http://localhost:3000
ENV=development
MAX_UPLOAD_MB=100
VITE_API_URL=http://localhost:8000

# LLM endpoints (optional). docker-compose.yml already ships the team's three
# vLLM servers; set these only to override them. A JSON list on ONE line:
# LLM_ENDPOINTS=[{"id":"main","name":"Main","base_url":"http://host:8000/v1","model":"qwen3.5","strength":6}]
# LLM_ENDPOINTS_DEFAULT=auto
